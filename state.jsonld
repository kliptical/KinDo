      "inputs": {
        "instruction": "Create ONE new test file. JavaScript ESM, node:test. before: null.\n\nFile - project/tests/phase3-inMemoryStateAdapter.test.js:\nImports: import { test, describe } from 'node:test'; import assert from 'node:assert/strict'; import { createInMemoryStateAdapter } from '../src/adapters/state/inMemoryStateAdapter.js'; import { createTaskDefinition } from '../src/entities/taskDefinition.js'; import { createTaskInstance } from '../src/entities/taskInstance.js'; import { createUser } from '../src/entities/user.js';\n\nHelpers at top:\n- makeUser(role='child') -> createUser({ role, displayName: 'Test ' + role })\n- makeTaskDef(overrides) -> createTaskDefinition base + spread overrides for clientSequence/updatedAt scenarios\n\ndescribe('3.2 InMemoryStateAdapter - basic CRUD', () => {\n  test('saveTaskDefinition stores entity by @id')\n  test('getTaskDefinition returns null for unknown id')\n  test('listTaskDefinitions with status active returns only active entities')\n  test('saveTaskInstance + getTaskInstance round-trip')\n  test('listTaskInstances with empty filter returns all')\n  test('listTaskInstances with assignedTo filter excludes other children')\n  test('listTaskInstances with status filter (pending vs completed) works')\n  test('listTaskInstances with taskDefinitionId filter works')\n  test('listTaskInstances with fromDate / toDate filters work')\n  test('saveUser + getUser + listUsers round-trip')\n});\n\ndescribe('3.2 InMemoryStateAdapter - \u00a75.1 LWW conflict resolution', () => {\n  test('higher clientSequence wins: save seq=1 then seq=2; get returns seq=2 entity')\n  test('lower clientSequence loses: save seq=2 then seq=1; get returns seq=2 entity (unchanged)')\n  test('equal clientSequence, later updatedAt wins: save seq=1 ts=A then seq=1 ts=B (B later); get returns B-version')\n  test('equal clientSequence, equal updatedAt: incoming wins (idempotent re-save)')\n  test('same LWW rules apply to saveTaskDefinition (operator I7: ignore \u00a73.2 immutability; apply LWW symmetrically)')\n  test('same LWW rules apply to saveUser')\n});\n\n// SPEC \u00a713 item 8\ndescribe('3.2 SPEC \u00a713 item 8 - conflicting TaskInstance', () => {\n  test('save two conflicting TaskInstance @id with different clientSequence; getTaskInstance returns higher-sequence version')\n});\n\nUse concrete ISO-8601 timestamps. Override ftm:clientSequence and ftm:updatedAt['@value'] on the test entities (NOT via the factory params; mutate the returned object) to construct conflict scenarios."
