        "instruction": "Create TWO new test files. JavaScript ESM, node:test. before: null for both.\n\nFile 1 - project/tests/phase3-tier0OrchestrationAdapter.test.js:\nImports: import { test, describe } from 'node:test'; import assert from 'node:assert/strict'; import { createTier0OrchestrationAdapter } from '../src/adapters/orchestration/tier0OrchestrationAdapter.js';\n\ndescribe('3.5 Tier0 OrchestrationAdapter', () => {\n  test('scheduleAt returns a string handle')\n  test('scheduleAt with past timestamp fires callback quickly (within ~50ms via setTimeout(0))')\n  test('scheduleAt with future timestamp 100ms out fires after delay; callback fired exactly once')\n  test('scheduleInterval returns a string handle and fires callback at interval boundaries')\n  test('cancel(handle) prevents the callback from firing')\n  test('cancel(handle) on an interval prevents subsequent fires')\n  test('onResume(now) is callable without error')\n});\nUse setTimeout(resolve, ms) for waiting in async tests. Keep waits short (50-150ms).\n\nFile 2 - project/tests/phase3-testOrchestrationAdapter.test.js:\nImports: import { test, describe } from 'node:test'; import assert from 'node:assert/strict'; import { createTestOrchestrationAdapter } from '../src/adapters/orchestration/testOrchestrationAdapter.js';\n\ndescribe('3.6 Test OrchestrationAdapter', () => {\n  test('tick fires all scheduleAt callbacks whose target <= tick timestamp')\n  test('multiple scheduleAt callbacks fire in ascending timestamp order on tick')\n  test('each scheduleAt callback fires exactly once per tick (not repeatedly)')\n  test('scheduleAt callback NOT fired when tick timestamp is before target')\n  test('scheduleInterval fires once per elapsed interval when tick advances by interval (3 intervals -> 3 fires)')\n  test('cancel(handle) prevents callback from firing on subsequent tick')\n  test('does not use real timers: no setTimeout / setInterval anywhere (assert by elapsed wallclock < 10ms across many ticks)')\n});\nUse synchronous side-effect tracking (e.g., a counter array) instead of async waits."
