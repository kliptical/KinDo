      "status": "ready",
      "inputs": {
        "instruction": "Create ONE new file. JavaScript ESM. No new dependencies. before: null.\n\nFile - project/src/modules/resumeReconciliation.js:\n\nimport { recurrenceMaterializer } from './recurrenceMaterializer.js';\nimport { reminderEvaluator } from './reminderEvaluator.js';\n\nExport async function resumeReconciliation({ stateAdapter, orchestrationAdapter, notificationAdapter, currentTime }) per SPEC \u00a76.1 + \u00a78.5.\n\nBehavior:\n1. Call orchestrationAdapter.onResume(currentTime) \u2014 informational.\n2. Load active recurring task definitions:\n   const allDefs = await stateAdapter.listTaskDefinitions({ status: 'active' });\n   const recurringDefs = allDefs.filter(d => d['ftm:schedule']['ftm:scheduleType'] === 'recurring');\n3. Load all task instances:\n   const allInstances = await stateAdapter.listTaskInstances();\n4. Call recurrenceMaterializer:\n   const { toCreate, skipped } = recurrenceMaterializer(recurringDefs, allInstances, currentTime);\n5. For each instance in toCreate:\n   await stateAdapter.saveTaskInstance(instance);\n   orchestrationAdapter.scheduleAt(instance['ftm:dueAt']['@value'], () => { /* placeholder reminder trigger; wired in Phase 4 */ });\n6. Re-evaluate all pending instances where dueAt <= currentTime:\n   const updatedInstances = await stateAdapter.listTaskInstances();\n   const pendingDue = updatedInstances.filter(i => i['ftm:completionState']['ftm:status'] === 'pending' && i['ftm:dueAt']['@value'] <= currentTime);\n   For each pending-due instance:\n     const def = await stateAdapter.getTaskDefinition(instance['ftm:taskDefinition']);\n     const verdict = reminderEvaluator(instance, def, currentTime);\n     if (verdict.shouldRemind) {\n       await notificationAdapter.send({ recipientUserId: instance['ftm:assignedTo'], title: def['ftm:title'], body: def['ftm:description'] ?? '', deepLinkUri: 'ftm://instance/' + instance['@id'].split(':').pop(), requestForegroundDisplay: true });\n     }\n7. Return { toCreate: toCreate.length, skipped };\n\nNo Phase 4 reminderSummary updates here (that flow lives in Phase 4 \u00a78.2 reminder-trigger). Document this scoping in JSDoc."
