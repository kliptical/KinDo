        "instruction": "Create TWO new per-module test files. JavaScript ESM, node:test. before: null for both. Self-contained.\n\nFile 1 - project/tests/phase2-completionProcessor.test.js:\nImports: import { test, describe } from 'node:test'; import assert from 'node:assert/strict'; import { completionProcessor } from '../src/modules/completionProcessor.js'; import { createTaskInstance } from '../src/entities/taskInstance.js';\n\nHelper at top of file:\n- makeInstance(overrides) -> TaskInstance; default assignedTo is 'urn:ftm:child:child-1'\n\ndescribe('2.3 CompletionProcessor', () => {\n  test('returns a NEW object (strict reference inequality with input)')\n  test('output completionState.status is completed')\n  test('output completedAt equals the completedAt argument')\n  test('output completedBy equals the completedBy argument')\n  test('output completedByRole equals the completedByRole argument')\n  test('output clientSequence equals input clientSequence + 1')\n  test('output updatedAt @value equals completedAt')\n  test('already-completed input returns instance with ftm:warning already-complete (no other mutation)')\n  test('completedByRole parent is recorded; completion semantics unchanged')\n  // SPEC \u00a713 item 5\n  test('\u00a713.5 parent completion via completionProcessor: output has completionState.status completed, completedByRole parent, clientSequence incremented')\n  // SPEC \u00a713 item 6 \u2014 note user-store check is Phase 4 deferred (I4)\n  test('\u00a713.6 NOTE: \u00a711 completedBy userId match check is Phase 4 deferred. This test confirms the structural contract: child completion with matching assignedTo passes through completionProcessor without throwing')\n});\n\nFile 2 - project/tests/phase2-taskListComputer.test.js:\nImports: import { test, describe } from 'node:test'; import assert from 'node:assert/strict'; import { taskListComputer } from '../src/modules/taskListComputer.js'; import { createTaskInstance } from '../src/entities/taskInstance.js';\n\nHelper at top of file:\n- makeInstance(assignedTo, dueAt, status='pending') -> TaskInstance with overrides; if status='completed', set completionState.status='completed'\n\ndescribe('2.4 TaskListComputer', () => {\n  test('filter by assignedTo excludes other children')\n  test('filter by status pending excludes completed')\n  test('filter by status completed excludes pending')\n  test('filter by fromDate excludes earlier instances')\n  test('filter by toDate excludes later instances')\n  test('empty filter returns all instances')\n  test('default sort is dueAt ascending')\n  test('equal dueAt: pending before completed')\n  test('does not mutate input array (original ordering preserved)')\n  // SPEC \u00a713 item 7\n  test('\u00a713.7 parent dashboard derives pending and completed lists from taskListComputer output only \u2014 no adapter call in test')\n});"
      },
