      "inputs": {
        "instruction": "Create one new test file. JavaScript ESM. Use node:test. before: null.\n\nFile \u2014 project/tests/phase2.test.js:\nImport: import { test, describe } from 'node:test'; import assert from 'node:assert/strict';\nAll imports use relative paths from tests/.\n\nWrite tests covering ALL acceptance criteria from IMPLEMENTATION_PLAN tasks 2.1-2.5 plus \u00a713 checklist items 1-7.\n\ndescribe('2.1 ScheduleComputer', () => {\n  test('one-time task with dueAt after referenceTime returns 1 instance')\n  test('one-time task with dueAt equal to referenceTime returns []')\n  test('one-time task with dueAt before referenceTime returns []')\n  test('recurring FREQ=DAILY with lookAheadSeconds 604800 returns 7 instances')\n  test('all recurring instances have dueAt > referenceTime and <= referenceTime + lookAheadSeconds')\n  test('default lookAheadSeconds is 604800 when options omitted')\n  test('invalid recurrenceRule returns [] with ftm:error invalid-rrule on array')\n  test('all returned instances have completionState.status pending and totalSent 0')\n  test('calling twice with same args returns same logical output (deterministic)')\n  // \u00a713 item 1\n  test('instantiate TaskDefinition and pass to ScheduleComputer without network')\n  // \u00a713 item 2\n  test('ScheduleComputer with recurring taskDef and referenceTime 4 days in past returns instances covering window; second call with same args is identical')\n});\n\ndescribe('2.2 ReminderEvaluator', () => {\n  test('completed instance returns shouldRemind false, reason already-complete')\n  test('dueAt after currentTime returns shouldRemind false, reason not-yet-due')\n  test('once mode totalSent 0 returns shouldRemind true, reason first-and-only')\n  test('once mode totalSent 1 returns shouldRemind false, reason once-sent')\n  test('persistent mode currentTime > dueAt + persistUntilSeconds returns false, persistence-window-expired')\n  test('persistent mode persistUntilSeconds absent currentTime = dueAt + 86401 returns false persistence-window-expired (default 86400)')\n  test('persistent mode persistUntilSeconds absent currentTime = dueAt + 86399 returns NOT persistence-window-expired')\n  test('persistent mode lastDeliveryStatus failed returns shouldRemind true, retry-after-failure')\n  test('persistent mode totalSent 0 returns shouldRemind true, initial-reminder')\n  test('persistent mode interval elapsed returns shouldRemind true, interval-elapsed')\n  test('persistent mode interval not elapsed returns shouldRemind false, interval-not-elapsed')\n  // \u00a713 item 4\n  test('ReminderEvaluator with lastDeliveryStatus failed returns shouldRemind true reason retry-after-failure')\n});\n\ndescribe('2.3 CompletionProcessor', () => {\n  test('returns new object (reference inequality)')\n  test('output completionState.status is completed')\n  test('output completedAt equals argument')\n  test('output completedBy equals argument')\n  test('output completedByRole equals argument')\n  test('output clientSequence equals input + 1')\n  test('output updatedAt equals completedAt')\n  test('already-completed input returns unchanged instance with ftm:warning already-complete')\n  test('completedByRole parent is stored correctly')\n  // \u00a713 item 5\n  test('parent completion passes all \u00a711 structural invariants (completedByRole parent, clientSequence incremented)')\n  // \u00a713 item 6 \u2014 validator rejects child with wrong completedBy\n  // Note: SPEC \u00a711 user-store checks deferred to Phase 4. Test the structural contract only.\n  test('child completion with correct assignedTo passes structural validation')\n});\n\ndescribe('2.4 TaskListComputer', () => {\n  test('filter by assignedTo excludes other children')\n  test('filter by status pending excludes completed')\n  test('filter by status completed excludes pending')\n  test('filter by fromDate excludes earlier instances')\n  test('filter by toDate excludes later instances')\n  test('empty filter returns all instances')\n  test('default sort is dueAt ascending')\n  test('equal dueAt: pending before completed')\n  test('does not mutate input array')\n  // \u00a713 item 7\n  test('render parent dashboard from TaskListComputer output only \u2014 no StateAdapter call')\n});\n\ndescribe('2.5 RecurrenceMaterializer', () => {\n  test('one recurring taskDef empty existingInstances returns toCreate with instances in look-ahead window')\n  test('deduplication: existing instance with matching taskDefinition and dueAt excluded from toCreate')\n  test('catchUpPolicy current-only: past missed occurrences excluded, skipped incremented')\n  test('catchUpPolicy current-only 3 missed: skipped === 3, toCreate contains only present/future')\n  test('all occurrences already exist: returns toCreate [] skipped 0')\n  test('does not mutate input arrays')\n  // \u00a713 item 3\n  test('RecurrenceMaterializer with fixture taskDefs and instances returns deterministic result; second call identical')\n});\n\nHelper factories at top of file (not in describe blocks):\n- makeTaskDef(overrides): creates a one-time TaskDefinition with sensible defaults, merges overrides\n- makeRecurringTaskDef(overrides): creates a recurring TaskDefinition with FREQ=DAILY, recurrenceStart set to 8 days ago, merges overrides\n- makeInstance(overrides): creates a TaskInstance with sensible defaults, merges overrides\n\nUse concrete ISO-8601 strings for timestamps, e.g. '2026-05-22T10:00:00Z'.\nFor \u00a713 item 6 (child completion validator test): since user-store checks are Phase 4 deferred, test only that completionProcessor does NOT throw and returns a structurally valid result for a child with matching assignedTo."
