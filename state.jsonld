                "lines": "41-57",
                "excerpt": "if (!recurrenceRule) {\n      const result = [];\n      result['ftm:error'] = 'invalid-rrule';\n      return result;\n    }\n    ...\n    } catch (_err) {\n      const result = [];\n      result['ftm:error'] = 'invalid-rrule';\n      return result;\n    }"
