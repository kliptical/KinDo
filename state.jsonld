                "file": "project/src/modules/recurrenceMaterializer.js",
                "lines": "33-65",
                "excerpt": "if (taskDef['ftm:schedule']['ftm:scheduleType'] !== 'recurring') { continue; }\n...\nif (candidates['ftm:error']) { continue; }\n...\nif (existingKeys.has(taskDef['@id'] + '|' + dueAt)) { continue; }\nif (catchUpPolicy === 'current-only' && dueAt < currentTime) { skipped++; continue; }\ntoCreate.push(candidate);"
